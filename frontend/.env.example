# Botpress Webchat Configuration
# Copy this file to .env and fill in your values

# Your Botpress bot's client ID (required)
# Find this in Botpress Cloud > Your Bot > Webchat > Client ID
VITE_BOTPRESS_CLIENT_ID=your_client_id_here

# Optional: Custom API URL (defaults to Botpress Cloud)
# VITE_BOTPRESS_API_URL=https://api.botpress.cloud
